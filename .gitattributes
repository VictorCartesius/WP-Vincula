# Normalize line endings: LF in the repository on every platform.
* text=auto eol=lf

# Source code
*.php   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.csv   text eol=lf

# Binary files must never be converted
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.zip   binary
